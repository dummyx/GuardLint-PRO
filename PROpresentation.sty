\def\PROheadtitle#1{\gdef\@PROheadtitle{#1}}

%% Comes from ipsj.cls
\def\ps@PROheadings{
 \def\@oddhead{\@Ltop
\rlap{\small
\ifDS@english
{\HeadfontE \@PROheadtitle}
\else
{\HeadfontJ \@PROheadtitle}
\fi
}
\hfil\@Rtop}
\let\@evenhead\@oddhead
\def\@oddfoot{\@Lbot
\hfil
{\botnomble
{\thepage}}
\@Rbot}
\let\@evenfoot\@oddfoot
\let\@mkboth\@gobbletwo
}
\let\ps@IPSJTITLEheadings=\ps@PROheadings
\let\ps@headings=\ps@PROheadings
\pagestyle{headings}

%% Received/Accepted dates are not included
\def\@uketsuke{}
\def\@euketsuke{}

%% To remove ``Regular Paper'' from the head of english title
%% Option DAM is included as default....
\def\SHUBETUname@DAM{\ifDS@english%
\else \leavevmode \fi}%%

%% \PROtitlenote for notice on manuscript
\newcommand{\PROtitlenote}[1]{\def\@PROtitlenote{#1}}
\def\@PROtitlenote{}
%% Suppress printing \footnotemark and numbers for \thanks
\def\thanks#1{\protected@xdef\@thanks{\@thanks\protect\footnotetext{#1}}}
\let\@origtitle\title
\def\title#1{\@origtitle{\ifx\@PROtitlenote\@empty{}\else\thanks{\@PROtitlenote}\fi#1}}
